def quebrar_texto(texto, largura=30):
  if not isinstance(texto, str):
    return texto
  return "\n".join(textwrap.wrap(texto, width=largura))
def padronizar_idade(valor):
  if not isinstance(valor, str):
    return valor
  val_limpo = valor.strip().lower()
  if "menor de 5" in val_limpo or "menos de 5" in val_limpo:
    return "Menos de 5 anos"
  elif (
      "entre 5 e 10" in val_limpo
      or "entre 5 e 11" in val_limpo
      or "entre 6 e 10" in val_limpo
  ):
    return "Entre 5 e 10 anos"
  elif "entre 11 e 18" in val_limpo:
    return "Entre 11 e 18 anos"
  elif "19 anos ou mais" in val_limpo:
    return "19 anos ou mais"
  elif "não sei" in val_limpo or "nao sei" in val_limpo:
    return "Não sei"
  return valor.strip()
def processar_e_plotar_grupo(pagina, planilha):
  linhas_unica = []
  try:
    aba_selecionada = planilha.worksheet(pagina)
    dados_aba = aba_selecionada.get_all_records()
    df_aba = pd.DataFrame(dados_aba)
    col_8 = [c for c in df_aba.columns if ".8." in c.lower()]
    col_15 = [c for c in df_aba.columns if ".15." in c.lower()]
    col_17 = [c for c in df_aba.columns if ".17." in c.lower()]
    if col_8 and col_15 and col_17:
      for idx, row in df_aba.iterrows():
        val_8 = row[col_8[0]]
        val_15 = row[col_15[0]]
        val_17 = row[col_17[0]]
