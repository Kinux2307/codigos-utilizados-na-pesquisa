def gerar_grafico_por_pagina(nome_pagina, titulo_grafico):
    try:
        aba_sel = planilha.worksheet(nome_pagina)
        dados = aba_sel.get_all_records()
        df_local = pd.DataFrame(dados)
    except Exception as e:
        print(f"Erro ao acessar a aba '{nome_pagina}': {e}")
        return
    prefixo_grupo = nome_pagina.replace('Grupo_', '')
    col_multipla = [
        c for c in df_local.columns
        if '.7.' in c.lower() and f".{prefixo_grupo.lower()}.7." in c.lower()
    ]
    if not col_multipla:
        col_multipla = [c for c in df_local.columns if '.7.' in c.lower()]
    linhas_locais = []
    for idx, row in df_local.iterrows():
        for col in col_multipla:
            frequencia_resposta = row[col]
            if pd.notna(frequencia_resposta) and str(frequencia_resposta).strip() != "":
                inicio_colchete = col.find('[')
                fim_colchete = col.find(']')
                if inicio_colchete != -1 and fim_colchete != -1:
                    espaco_nome = col[inicio_colchete+1:fim_colchete]
                else:
                    espaco_nome = col
                linhas_locais.append({
                    'Espaço da USP': quebrar_texto(espaco_nome, 25),
                    'Frequência de Uso': quebrar_texto(str(frequencia_resposta).strip(), 20)
                })
    df_consolidado_local = pd.DataFrame(linhas_locais)
    if not df_consolidado_local.empty:
        plt.figure(figsize=(14, 8))
        ax = sns.countplot(
            data=df_consolidado_local,
            y='Espaço da USP',
            hue='Frequência de Uso',
            palette='YlGnBu',
            alpha=1,
            edgecolor='black',
            linewidth=0.4
        )
        plt.title(titulo_grafico, fontsize=16, pad=20, fontweight='bold')
        plt.xlabel('Quantidade de Respondentes', fontsize=13, labelpad=10)
        plt.ylabel('Espaços Avaliados', fontsize=13, labelpad=10)
        plt.legend(title='Frequência de Uso', bbox_to_anchor=(1.02, 1), loc='upper left', fontsize=11, title_fontsize=12)
        plt.tight_layout()
        plt.show()
    else:
        print(f"Nenhuma resposta válida encontrada para o grupo de perguntas na aba {nome_pagina}.")
